{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "build",

    "strict": true,
    "esModuleInterop": true,

    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "data"],
  "exclude": ["node_modules", "build"]
}